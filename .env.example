# =====================================================================
# Fake Medicine Detection System — Environment Configuration Template
# Academic Project: MIT-ADT University, Pune | School of Computing | Group 1603
# =====================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' before running in production.
# 2. Never commit your actual '.env' file containing real secrets to GitHub.
# =====================================================================

# Server Network Configuration
PORT=5000
HOST=127.0.0.1
ENVIRONMENT=development

# Database Persistence
# Path to local SQLite relational database file
DATABASE_PATH=mediverify.db

# Cryptographic & Session Security
# Provide a strong 64-character random string for HMAC-SHA256 JWT signing
JWT_SECRET=mit_adt_group_1603_fake_medicine_detection_jwt_secret_change_me_in_production
JWT_EXPIRATION_SECONDS=604800

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Regulatory Portal Endpoints (Mock / Future Extensibility)
CDSCO_REGISTRY_URL=https://cdsco.gov.in/api/v1/medicines
NPPA_PRICING_URL=https://nppa.gov.in/api/v1/mrp-schedule
